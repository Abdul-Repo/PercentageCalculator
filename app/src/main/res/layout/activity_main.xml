<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/black_green_bg_cp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">

        <ImageView
            android:id="@+id/mainHdrImg"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/bannerbgblack" />

        <!-- Futuristic About Button - Positioned between header and toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/AboutButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="ABOUT"
            android:textColor="#00FFD4"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.1"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconTint="#00FFD4"
            app:backgroundTint="#2200FFD4"
            app:strokeColor="#00FFD4"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/mainHdrImg"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Main Content Card with Glassmorphism Effect -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#CC000000"
            app:cardCornerRadius="20dp"
            app:strokeColor="#00FFD4"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/AboutButton"
            app:layout_constraintWidth_max="600dp"
            app:layout_constraintVertical_bias="0.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <Switch
                    android:id="@+id/percentValueSwt"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:text="Percentage / Value Mode"
                    android:textColor="#00FFD4"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:thumbTint="#00FFD4"
                    android:trackTint="#4400FFD4"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/kTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/total"
                    android:textColor="#00FFD4"
                    android:fontFamily="sans-serif-condensed-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/percentValueSwt" />

                <EditText
                    android:id="@+id/vTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#44FFFFFF"
                    android:backgroundTint="#00FFD4"
                    app:layout_constraintBaseline_toBaselineOf="@+id/kTotal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/kTotal" />

                <TextView
                    android:id="@+id/kPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/percentage"
                    android:textColor="#00FFD4"
                    android:fontFamily="sans-serif-condensed-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vTotal" />

                <EditText
                    android:id="@+id/vPercentage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="0%"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#44FFFFFF"
                    android:backgroundTint="#00FFD4"
                    app:layout_constraintBaseline_toBaselineOf="@+id/kPercent"
                    app:layout_constraintEnd_toStartOf="@+id/kPart"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/kPercent" />

                <TextView
                    android:id="@+id/kPart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/value"
                    android:textColor="#00FFD4"
                    android:fontFamily="sans-serif-condensed-medium"
                    app:layout_constraintBaseline_toBaselineOf="@+id/kPercent"
                    app:layout_constraintEnd_toStartOf="@+id/vPart"
                    app:layout_constraintStart_toEndOf="@+id/vPercentage" />

                <EditText
                    android:id="@+id/vPart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#44FFFFFF"
                    android:backgroundTint="#00FFD4"
                    app:layout_constraintBaseline_toBaselineOf="@+id/kPercent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/kPart" />

                <ToggleButton
                    android:id="@+id/affectValueSwt"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#22FF0055"
                    android:textOff="TOTAL - RESULT"
                    android:textOn="TOTAL + RESULT"
                    android:textColor="#FF0055"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vPercentage" />

                <TextView
                    android:id="@+id/affectValuetxt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="---"
                    android:textAlignment="center"
                    android:textColor="#00FFD4"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:shadowColor="#00FFD4"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"
                    app:layout_constraintBottom_toBottomOf="@+id/affectValueSwt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/affectValueSwt"
                    app:layout_constraintTop_toTopOf="@+id/affectValueSwt" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/AboutCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="#EE1A1A2E"
            app:cardCornerRadius="24dp"
            app:strokeColor="#00FFD4"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="@string/about_title"
                        android:textColor="#00FFD4"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed-medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/DevProfileImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/author"
                        app:shapeAppearanceOverlay="@style/Widget.Material3.CircularView"
                        app:strokeColor="#00FFD4"
                        app:strokeWidth="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_content"
                        android:textColor="#E0FFFFFF"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="sans-serif-condensed" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/CloseAboutButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="24dp"
                        android:text="DISMISS"
                        android:textColor="#FF0055"
                        android:fontFamily="sans-serif-condensed-medium" />
                </LinearLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
